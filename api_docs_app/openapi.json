    "/pipesense/incidents/{incident_id}/investigate": {
      "post": {
        "tags": [
          "PipeSense - Anomaly & Incidents"
        ],
        "summary": "Trigger Autonomous Agent Investigation",
        "description": "Runs the multi-tool contextual investigation agent:\n1. `check_weather`: Rules out irrigation and rainfall anomalies.\n2. `check_peer_baselines`: Compares adjacent zone baselines to rule out pressure spikes.\n3. `check_maintenance_history`: Inspects historical work orders for fissures/cracks.\n4. `check_occupancy`: Confirms standard rest hours vs. lab activities.\nTransitions state to `LEAK_CONFIRMED` and calculates pre-repair estimated daily water loss.\n",
        "operationId": "investigatePipeIncident",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "description": "Unique incident identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Investigation completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Incident"
                }
              }
            }
          },
          "400": {
            "description": "Invalid state transition.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
