    "/drainpilot/detect": {
      "post": {
        "tags": [
          "DrainPilot - Detection & Incidents"
        ],
        "summary": "Ingest Drainage Telemetry & Detect Anomaly",
        "description": "Evaluates stormwater/drainage chamber parameters against deterministic multi-threshold rules:\n- Fill ratio (warning >= 65%, critical >= 85%)\n- Rapid water-level rise (rate of rise >= 15 cm/hr)\n- Freeboard overflow margin (headroom <= 15 cm)\n- Pump status anomaly (TRIPPED, FAULT, FAILED)\n",
        "operationId": "detectDrainAnomaly",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DrainTelemetryDetectRequest"
              },
              "example": {
                "zone": "DRAIN-NORTH-01",
                "chamber_depth_cm": 100.0,
                "water_level_cm": 88.0,
                "baseline_water_level_cm": 20.0,
                "rate_of_rise_cm_per_hr": 16.5,
                "pump_status": "OFF"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Anomaly or overflow risk detected. Created incident returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Incident"
                }
              }
            }
          },
          "200": {
            "description": "Telemetry within safe nominal limits. No incident created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrainNominalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or missing JSON body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
