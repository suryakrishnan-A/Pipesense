                }
              }
            }
          },
          "409": {
            "description": "Invalid state transition (incident must be in WORK_ORDER_ISSUED or REPAIRING).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/drainpilot/work-orders/{work_order_id}/verify": {
      "post": {
        "tags": [
          "DrainPilot - Work Orders & Dispatch"
        ],
        "summary": "Verify Post-Maintenance Drainage Telemetry",
        "description": "Submits physical post-maintenance telemetry to verify chamber capacity restoration against strict thresholds:\n- Fill ratio <= 0.45 (safe fill ratio)\n- Freeboard >= 30 cm\n- Rate of rise <= 5.0 cm/hr\n- Pump status is not faulted\nIf passed, closes incident. If failed, transitions incident to `ESCALATED` and reassigns to Senior Civil Supervisor.\n",
        "operationId": "verifyDrainWorkOrder",
        "parameters": [
          {
            "name": "work_order_id",
            "in": "path",
            "required": true,
            "description": "Work order identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DrainVerifyRequest"
              },
              "example": {
                "water_level_cm": 25.0,
                "chamber_depth_cm": 100.0,
                "rate_of_rise_cm_per_hr": 2.0,
                "pump_status": "OFF"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Telemetry verification completed. Returns updated incident state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Incident"
                }
              }
            }
          },
          "400": {
            "description": "Malformed telemetry or wrong system.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Work order not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Invalid state transition (incident must be in VERIFYING state).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/drainpilot/work-orders/{work_order_id}/repair": {
      "post": {
        "tags": [
          "DrainPilot - Work Orders & Dispatch"
        ],
        "summary": "Initiate Second Drainage Maintenance Attempt",
        "description": "Initiates second repair attempt for an escalated drainage work order, moving the incident back into `REPAIRING` state.",
        "operationId": "repairDrainWorkOrder",
        "parameters": [
          {
            "name": "work_order_id",
            "in": "path",
            "required": true,
            "description": "Work order identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Second repair started.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Incident"
                }
              }
            }
          },
          "400": {
            "description": "Wrong system.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Work order not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Invalid state transition (incident must be in ESCALATED state).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/drainpilot/summary": {
      "get": {
        "tags": [
          "DrainPilot - Summary"
        ],
        "summary": "Get DrainPilot Operational Summary",
        "description": "Queries operational metrics specific to drainage chambers, overflow risks, and pump statuses.",
        "operationId": "getDrainSummary",
        "responses": {
          "200": {
            "description": "Drainage operational summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrainPilotSummary"
                }
              }
            }
          }
        }
      }
    },
    "/demo/pipesense/reset": {
      "post": {
        "tags": [
          "Simulation & Demo"
        ],
        "summary": "Reset Demo State",
        "description": "Resets all in-memory incidents, events, and work orders to a clean baseline state.",
        "operationId": "resetDemo",
        "responses": {
          "200": {
            "description": "Demo state successfully reset.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Demo reset complete."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/demo/pipesense/run": {
      "post": {
        "tags": [
          "Simulation & Demo"
        ],
        "summary": "Run Full PipeSense Closed-Loop Demo",
        "description": "Executes the complete end-to-end resilience loop (Anomaly -> Investigation -> Dispatch -> Claim Completion -> Failed Verification & Escalation -> Second Repair -> Passed Verification & Impact Measurement).",
        "operationId": "runDemo",
        "responses": {
          "200": {
            "description": "Complete demo execution result including final resolved incident and event timeline.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "incident": {
                      "$ref": "#/components/schemas/Incident"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Incident": {
        "type": "object",
        "properties": {
          "incident_id": {
            "type": "string",
            "example": "INC-1728500000"
          },
          "zone": {
            "type": "string",
            "example": "BLDG-04"
          },
          "baseline_flow_lpm": {
            "type": "number",
            "format": "float",
            "example": 18.4
          },
          "current_flow_lpm": {
            "type": "number",
            "format": "float",
            "example": 64.2
          },
          "system": {
            "type": "string",
            "enum": [
              "PIPE",
              "DRAIN"
            ],
            "example": "PIPE"
          },
          "state": {
            "type": "string",
            "enum": [
              "NOMINAL",
              "ANOMALY",
              "INVESTIGATING",
              "LEAK_CONFIRMED",
              "LEAK_SUSPECTED",
              "LEGITIMATE_USAGE",
              "WORK_ORDER_ISSUED",
              "VERIFYING",
              "FAILED_VERIFICATION",
              "ESCALATED",
              "REPAIRING",
              "RESOLVED",
              "CLOSED"
            ],
            "example": "LEAK_CONFIRMED"
          },
          "severity": {
            "type": "string",
            "example": "CRITICAL"
          },
          "priority": {
            "type": "string",
            "example": "P1"
          },
          "confidence": {
            "type": "number",
            "format": "float",
            "example": 0.98
          },
          "description": {
            "type": "string",
            "example": "Abnormal flow detected: 64.2 L/min (3.49x baseline)"
          },
          "diagnosis": {
            "type": "string",
            "example": "LEAK_CONFIRMED"
          },
          "detected_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-09T02:45:00"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-09T02:45:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-09T02:45:30"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "estimated_daily_loss_liters": 65952.0,
              "agent_evidence": {
                "weather": "Clear / No Rain",
                "neighboring_baselines": "1.0x (Normal)",
                "structural_vulnerability": "Basement Secondary Riser fissure recorded"
              }
            }
          }
        }
      },
      "WorkOrder": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "string",
            "example": "WO-7A8B9C"
          },
          "incident_id": {
            "type": "string",
            "example": "INC-1728500000"
          },
          "priority": {
            "type": "string",
            "example": "P1"
          },
          "assigned_role": {
            "type": "string",
            "example": "Senior Plumber"
          },
          "assigned_person": {
            "type": "string",
            "example": "On-call Senior Plumber"
          },
          "zone": {
            "type": "string",
            "example": "BLDG-04"
          },
          "description": {
            "type": "string",
            "example": "Basement Secondary Riser"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "ASSIGNED",
              "COMPLETION_CLAIMED",
              "VERIFIED",
              "FAILED_VERIFICATION",
              "ESCALATED",
              "IN_PROGRESS",
              "CLOSED"
            ],
            "example": "ASSIGNED"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PASSED",
              "FAILED"
            ],
            "example": "PENDING"
          },
          "completion_claimed_at": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string",
            "example": "ANOMALY_DETECTED"
          },
          "incident_id": {
            "type": "string",
            "nullable": true,
            "example": "INC-1728500000"
          },
          "work_order_id": {
            "type": "string",
            "nullable": true,
            "example": "WO-7A8B9C"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PipeSenseDetectRequest": {
        "type": "object",
        "required": [
          "zone",
          "current_flow",
          "baseline_flow"
        ],
        "properties": {
          "zone": {
            "type": "string",
            "description": "Campus building or pipe zone code",
            "example": "BLDG-04"
          },
          "current_flow": {
            "type": "number",
            "format": "float",
            "description": "Measured flow in Liters per minute",
            "example": 64.2
          },
          "baseline_flow": {
            "type": "number",
            "format": "float",
            "description": "Expected baseline flow in Liters per minute",
            "example": 18.4
          }
        }
      },
      "PipeSenseVerifyRequest": {
        "type": "object",
        "required": [
          "telemetry"
        ],
        "properties": {
          "telemetry": {
            "type": "number",
            "format": "float",
            "description": "Post-repair measured flow rate in L/min",
            "example": 18.2
          }
        }
      },
      "DrainTelemetryDetectRequest": {
        "type": "object",
        "required": [
          "zone",
          "chamber_depth_cm",
          "water_level_cm"
        ],
        "properties": {
          "zone": {
            "type": "string",
            "description": "Stormwater chamber or drainage zone ID",
            "example": "DRAIN-NORTH-01"
          },
          "chamber_depth_cm": {
            "type": "number",
            "format": "float",
            "description": "Total chamber depth in cm",
            "example": 100.0
          },
          "water_level_cm": {
            "type": "number",
            "format": "float",
            "description": "Measured water level in cm",
            "example": 88.0
          },
          "baseline_water_level_cm": {
            "type": "number",
            "format": "float",
            "description": "Standard dry baseline water level in cm",
            "example": 20.0
          },
          "rate_of_rise_cm_per_hr": {
            "type": "number",
            "format": "float",
            "description": "Water level rate of rise in cm per hour",
            "example": 16.5
          },
          "pump_status": {
            "type": "string",
            "description": "Current submersible pump operational status",
            "enum": [
              "OFF",
              "ON",
              "TRIPPED",
              "ALERT_OVERHEAT",
              "FAILED",
              "FAULT"
            ],
            "example": "OFF"
          },
          "timestamp": {
            "type": "string",
            "description": "Telemetry timestamp",
            "example": "2026-10-09T02:45:00"
          }
        }
      },
      "DrainVerifyRequest": {
        "type": "object",
        "required": [
          "water_level_cm"
        ],
        "properties": {
          "water_level_cm": {
            "type": "number",
            "format": "float",
            "description": "Post-maintenance chamber water level in cm",
            "example": 25.0
          },
          "chamber_depth_cm": {
            "type": "number",
            "format": "float",
            "description": "Chamber depth in cm",
            "example": 100.0
          },
          "rate_of_rise_cm_per_hr": {
            "type": "number",
            "format": "float",
            "description": "Post-maintenance rate of rise in cm/hr",
            "example": 2.0
          },
          "pump_status": {
            "type": "string",
            "description": "Pump status",
            "example": "OFF"
          }
        }
      },
      "NominalFlowResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Nominal flow"
          }
        }
      },
      "DrainNominalResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "NOMINAL"
          },
          "message": {
            "type": "string",
            "example": "Drainage telemetry within safe operating parameters. No anomaly detected."
          },
          "is_simulated": {
            "type": "boolean",
            "example": true
          },
          "data_origin": {
            "type": "string",
            "example": "SIMULATED_BENCHMARK_TELEMETRY"
          }
        }
      },
      "PipeSenseSummary": {
        "type": "object",
        "properties": {
          "total_zones": {
            "type": "integer",
            "example": 14
          },
          "active_incidents": {
            "type": "integer",
            "example": 1
          },
          "critical_incidents": {
            "type": "integer",
            "example": 1
          },
          "resolved_today": {
            "type": "integer",
            "example": 0
          },
          "estimated_daily_loss_liters": {
            "type": "number",
            "format": "float",
            "example": 65952.0
          },
          "verified_daily_loss_avoided_liters": {
            "type": "number",
            "format": "float",
            "example": 0.0
          }
        }
      },
      "PipeSenseImpact": {
        "type": "object",
        "properties": {
          "estimated_daily_loss_liters": {
            "type": "number",
            "example": 65952.0
          },
          "verified_daily_loss_avoided_liters": {
            "type": "number",
            "example": 66240.0
          },
          "baseline_flow_lpm": {
            "type": "number",
            "example": 18.4
          },
          "peak_abnormal_flow_lpm": {
            "type": "number",
            "example": 64.2
          },
          "verified_post_repair_flow_lpm": {
            "type": "number",
            "example": 18.2
          },
          "water_loss_reduction_lpm": {
            "type": "number",
            "example": 46.0
          }
        }
      },
      "DrainPilotSummary": {
        "type": "object",
        "properties": {
          "total_chambers_monitored": {
            "type": "integer",
            "example": 12
          },
          "active_drainage_incidents": {
            "type": "integer",
            "example": 1
          },
          "critical_overflow_risks": {
            "type": "integer",
            "example": 1
          },
          "resolved_drainage_incidents": {
            "type": "integer",
            "example": 0
          },
          "open_drainage_work_orders": {
            "type": "integer",
            "example": 1
          },
          "pump_stations_tripped": {
            "type": "integer",
            "example": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Incident not found"
          },
          "is_simulated": {
            "type": "boolean",
            "example": true
          }
        }
      }
    }
  }
}