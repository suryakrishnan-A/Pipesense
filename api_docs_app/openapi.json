{
  "openapi": "3.0.3",
  "info": {
    "title": "PipeSense & DrainPilot Operational Resilience API",
    "version": "2.0.0",
    "description": "### Integrated Water & Grid Resilience Platform (Campus Infrastructure)\nAutonomous closed-loop operational agents for campus infrastructure monitoring, anomaly detection, autonomous context investigation, crew dispatch, and physical sensor verification.\n\n- **PipeSense Engine**: Monitors indoor/potable water distribution networks, detects night-flow leaks, investigates contextual causes (weather, occupancy, baseline, maintenance), and performs post-repair physical telemetry verification.\n- **DrainPilot Engine**: Monitors campus stormwater and drainage chambers, identifies silt blockages, rapid rise, and pump station faults, ensuring full flood resilience and verified civil maintenance closure.\n\n*Target Backend Server runs on Port 5001.*\n"
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Local PipeSense & DrainPilot API Backend (Port 5001)"
    },
    {
      "url": "http://127.0.0.1:5001",
      "description": "Local Loopback IP (Port 5001)"
    }
  ],
  "tags": [
    {
      "name": "PipeSense - Anomaly & Incidents",
      "description": "Potable water telemetry ingestion, leak detection, autonomous agent investigation, and crew dispatch."
    },
    {
      "name": "PipeSense - Metrics & Impact",
      "description": "Operational summaries, water loss reduction calculations, and sustainability impact metrics."
    },
    {
      "name": "DrainPilot - Detection & Incidents",
      "description": "Stormwater chamber telemetry, overflow risk alerts, and autonomous drainage investigation."
    },
    {
      "name": "DrainPilot - Work Orders & Dispatch",
      "description": "Drainage maintenance work orders, technician completion claims, and post-repair physical verification."
    },
    {
      "name": "DrainPilot - Summary",
      "description": "Drainage network operational metrics and pump station health status."
    },
    {
      "name": "Work Orders & Closed-Loop Verification",
      "description": "Cross-system work order tracking and closed-loop verification endpoints."
    },
    {
      "name": "Events & Audit Trail",
      "description": "Immutable event streaming and audit trail per incident."
    },
    {
      "name": "Simulation & Demo",
      "description": "One-click interactive walkthrough and demo state reset endpoints."
    }
  ],
  "paths": {
    "/pipesense/detect": {
      "post": {
        "tags": [
          "PipeSense - Anomaly & Incidents"
        ],
        "summary": "Detect Pipe Anomaly / Water Leak Surge",
        "description": "Evaluates current water flow against baseline flow. Flags an incident if the ratio exceeds 1.35x.",
        "operationId": "detectPipeAnomaly",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipeSenseDetectRequest"
              },
              "example": {
                "zone": "BLDG-04",
                "current_flow": 64.2,
                "baseline_flow": 18.4
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Detection evaluation result. Returns created Incident object if anomalous, or nominal status message.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": {
                    "$ref": "#/components/schemas/NominalFlowResponse"
                  }
                },
                "examples": {
                  "anomaly": {
                    "summary": "Anomaly Detected (Leak Surge)",
                    "value": {
                      "incident_id": "INC-1728500000",
                      "zone": "BLDG-04",
                      "baseline_flow_lpm": 18.4,
                      "current_flow_lpm": 64.2,
                      "system": "PIPE",
                      "state": "ANOMALY",
                      "severity": "UNKNOWN",
                      "priority": "UNASSIGNED",
                      "confidence": 0.0,
                      "description": "Abnormal flow detected: 64.2 L/min (3.49x baseline)",
                      "diagnosis": "",
                      "detected_at": "2026-10-09T02:45:00",
                      "created_at": "2026-10-09T02:45:00",
                      "updated_at": "2026-10-09T02:45:00",
                      "metadata": {}
                    }
                  },
                  "nominal": {
                    "summary": "Nominal Flow",
                    "value": {
                      "message": "Nominal flow"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
