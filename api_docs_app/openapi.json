          "Work Orders & Closed-Loop Verification"
        ],
        "summary": "Claim Work Order Completion",
        "description": "Technician marks repair complete. Crucially, the system does **not** close the ticket.\nInstead, it moves the incident to `VERIFYING` state and initiates post-repair telemetry evaluation.\n",
        "operationId": "completeWorkOrder",
        "parameters": [
          {
            "name": "work_order_id",
            "in": "path",
            "required": true,
            "description": "Unique work order identifier (e.g. WO-A1B2C3)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Completion recorded; verification cycle initiated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Incident"
                }
              }
            }
          },
          "400": {
            "description": "Invalid state transition.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/work-orders/{work_order_id}/verify": {
      "post": {
        "tags": [
          "Work Orders & Closed-Loop Verification"
        ],
        "summary": "Verify Physical Telemetry Post-Repair",
        "description": "Ingests post-repair telemetry flow rate:\n- If flow <= baseline * 1.35: Verifies fix, calculates avoided daily loss, transitions to `RESOLVED` and then `CLOSED`.\n- If flow > baseline * 1.35: Rejects false claim, transitions incident to `ESCALATED`, reassigns ticket to Senior Supervisor.\n",
        "operationId": "verifyWorkOrder",
        "parameters": [
          {
            "name": "work_order_id",
            "in": "path",
            "required": true,
            "description": "Unique work order identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipeSenseVerifyRequest"
              },
              "example": {
                "telemetry": 18.2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification evaluated. Returns updated incident state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Incident"
                }
              }
            }
          },
          "400": {
            "description": "Incident not in VERIFYING state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
