# ENVIRONMENT VARIABLES
# Mode: local deterministic by default
PIPESENSE_MODE=local

# AWS Bedrock Integration Configuration (Server-Side Only)
# Set USE_AWS_BEDROCK=true to activate Amazon Bedrock reasoning via Strands Agents SDK.
# When false or unset, PipeSense defaults safely to the local deterministic rule engine.
USE_AWS_BEDROCK=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS Credentials:
# DO NOT put raw AWS credentials or secret keys here.
# Configure AWS credentials via AWS CLI (`aws configure`), AWS SSO, or standard IAM role/environment variables.

# Telemetry Config
BASELINE_LPM=18.4

